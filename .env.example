# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# ============================================================================
# Project Settings
# ============================================================================
PROJECT_NAME=pfl-stress-prediction
ENVIRONMENT=development  # development, testing, production
DEBUG=false

# ============================================================================
# Data Paths
# ============================================================================
DATA_ROOT=./data
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
# Specific dataset paths (Auto-created by make init-structure)
WESAD_DATA_PATH=./data/raw/wesad
FITBIT_DATA_PATH=./data/fitbit

# ============================================================================
# Model Settings
# ============================================================================
MODEL_CHECKPOINT_DIR=./checkpoints
MODEL_OUTPUT_DIR=./outputs
EXPERIMENT_NAME=baseline_v1

# ============================================================================
# Training Configuration
# ============================================================================
DEVICE=cuda  # options: cuda, cpu, mps (for Apple Silicon)
NUM_WORKERS=4  # Set to 0 for easier debugging on Windows
PIN_MEMORY=true
SEED=42

# ============================================================================
# Federated Learning Settings
# ============================================================================
FL_NUM_CLIENTS=15
FL_ROUNDS=100
FL_CLIENT_FRACTION=1.0
FL_LOCAL_EPOCHS=5

# ============================================================================
# Logging and Monitoring
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/training.log

# Weights & Biases (Detailed experiment tracking)
WANDB_ENABLED=false
WANDB_PROJECT=federated-stress-detection
WANDB_ENTITY=your-username
WANDB_API_KEY=your-api-key-here

# MLflow (Alternative tracking)
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=stress-detection

# TensorBoard
TENSORBOARD_LOG_DIR=./runs

# ============================================================================
# External API Keys & Secrets
# ============================================================================
# Fitbit API (Required for Iteration 3 - Personalization)
FITBIT_CLIENT_ID=your-client-id
FITBIT_CLIENT_SECRET=your-client-secret
FITBIT_ACCESS_TOKEN=your-access-token

# Codecov (Required for GitHub Actions CI/CD)
# Get this from codecov.io to see coverage reports online
CODECOV_TOKEN=your-codecov-token-here

# ============================================================================
# Development Tools
# ============================================================================
# Jupyter notebook settings
JUPYTER_PORT=8888
JUPYTER_TOKEN=your-jupyter-token

# ============================================================================
# Demo Application (Streamlit)
# ============================================================================
DEMO_HOST=localhost
DEMO_PORT=8501
DEMO_MODEL_PATH=./checkpoints/best_model.pth
