# Auto detect text files and perform LF normalization
* text=auto

# Source code - Enforce LF (Unix style) for consistency across OS
*.py text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf
*.pxi text eol=lf

# Configuration files
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf
*.tex text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts - Keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf


# JUPYTER NOTEBOOKS

# Treat as text for diffs, but exclude from language stats
*.ipynb text eol=lf linguist-documentation
# Set a specific diff driver 
*.ipynb diff=jupyternotebook


# DATA & BINARY FILES

# Standard Data - mark as binary to prevent git diff garbage
*.csv binary
*.tsv binary
*.pkl binary
*.pickle binary
*.npy binary
*.npz binary
*.h5 binary
*.hdf5 binary
*.parquet binary

# Physiological/Sensor Data specific formats (WESAD/Hospital data)
*.mat binary
*.edf binary
*.xdf binary
*.dat binary

# Model files - binary
*.pth binary
*.pt binary
*.ckpt binary
*.safetensors binary
*.onnx binary
*.pb binary
*.tflite binary

# Media
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg text
*.mp4 binary
*.avi binary
*.mov binary
*.mkv binary

# Archives & Docs
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.rar binary
*.7z binary
*.pdf binary
*.doc binary
*.docx binary
*.ppt binary
*.pptx binary
*.xls binary
*.xlsx binary

# GITHUB STATS (LINGUIST)

# Exclude data and docs from repo language stats
data/* linguist-vendored
docs/* linguist-documentation
assets/* linguist-vendored

# GIT LFS (Large File Storage)
# recommended for a PyTorch project 
 *.pth filter=lfs diff=lfs merge=lfs -text
 *.pt filter=lfs diff=lfs merge=lfs -text
 *.ckpt filter=lfs diff=lfs merge=lfs -text
 *.pkl filter=lfs diff=lfs merge=lfs -text
 *.onnx filter=lfs diff=lfs merge=lfs -text